# Copy this file to `.env` and fill in the values you need.
# `.env` itself is ignored by git — never commit real credentials.

# ── verifier preset (highest priority) ────────────────────────────────────
# VERIFIER_BASE_URL=https://api.deepseek.com
# VERIFIER_API_KEY=
# VERIFIER_MODEL=deepseek-v4-flash
# VERIFIER_EFFORT=high
# VERIFIER_MAX_TOKENS=32768
# VERIFIER_MAX_CONCURRENCY=8
# VERIFIER_TIMEOUT_MS=120000

# ── DeepSeek official API fallback ────────────────────────────────────────
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_EFFORT=high
# DEEPSEEK_MAX_TOKENS=32768

# ── OpenAI-compatible local/remote server fallback ─────────────────────────
# Set the server's `/v1` root and an API key (use EMPTY for local vLLM/SGLang).
# OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
